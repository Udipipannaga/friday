# Copy to .env in this directory for Docker Compose.
# For local Windows development, copy to backend/.env instead.
# Never commit .env or paste keys into chat.
FRIDAY_PROVIDER=openai
FRIDAY_MODEL=
FRIDAY_API_KEY=
FRIDAY_OLLAMA_URL=http://ollama:11434
FRIDAY_SEARCH_KEY=
FRIDAY_ORIGIN=http://localhost:8000
FRIDAY_SECURE_COOKIE=false
FRIDAY_REGISTRATION_OPEN=false
FRIDAY_DAILY_JOBS=30
FRIDAY_MAX_ACTIVE_JOBS=3
FRIDAY_MAX_OUTPUT_TOKENS=3000
# Required by Compose. Choose a strong password. Not used in local SQLite mode.
POSTGRES_PASSWORD=
